<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="30dp"
    android:background="#0B0F17">

    <TextView
        android:id="@+id/pass_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="输入 WiFi 密码"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#F9FAFB" />

    <TextView
        android:id="@+id/pass_ssid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text=""
        android:textSize="16sp"
        android:textColor="#93C5FD" />

    <TextView
        android:id="@+id/pass_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:padding="14dp"
        android:minHeight="60dp"
        android:background="@drawable/item_bg"
        android:text=""
        android:textSize="24sp"
        android:textColor="#FDE68A"
        android:gravity="center_vertical" />

    <TextView
        android:id="@+id/pass_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="方向键选择 · 确认键输入 · 返回键删除"
        android:textSize="13sp"
        android:textColor="#6B7280" />

    <GridLayout
        android:id="@+id/pass_keys"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:columnCount="7"
        android:rowCount="4" />

    <LinearLayout
        android:id="@+id/pass_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal" />

</LinearLayout>
